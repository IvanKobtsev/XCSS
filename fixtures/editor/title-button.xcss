@keyframes slidingAnimation {
  0% { background-position: 0 0; }
  100% { background-position: -25.5px 0; }
}

$start-point = 60px;
$offset = 40px;
$gradient-range = 50px;
$initial-offset = 20px;

.TitleButton {
  position: relative;
  width: 825px;
  height: 86px;
  padding: 0;
  cursor: pointer;
  background: none;
  border: none;
  outline: none;
  mask-image: linear-gradient(90deg, black 0, black (100% - 350px), transprent 100%);

  .titleWrapper {
    width: 10ss0%;
    height: 100%;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    padding-left: 120px;
    transition: 0.4s all;
    .titleText {
      font-family: Lexend, sans-serif;
      font-size: 37px;
      font-weight: 500;
      transition: 0.4s all;
      color: #fff;
    }
    svg {
      scale: 0.75;
      margin-left: 18px;
      transition: 0.4s all;
      opacity: 0;
    }
  }
  .background {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: -1;
    width: 100%;
    height: 0;
    background-color: #fff;
    opacity: 0;
    transition: 0.4s all;
  }
  .smallSlidingTriangles {
    top: 4px;
    position: absolute;
    width: 100%;
    height: 12px;
    z-index: 2;
    background-image: url("../../../assets/img/small-sliding-trisangles.png");
    background-repeat: repeat-x;
    background-size: 25.5px 12px;
    animation: slidingAnimation 0.8s linear infinite;
    &.reverse {
      top: unset;
      bottom: 4px;
      animation-direction: reverse;
    }
  }
  .piercingLine {
    $text-width = 200px;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 100%;
    height: 4px;
    z-index: -1;
    transition: 0.4s all;
    background: linear-gradient(90deg, #fff $start-point, transparent ($start-point + $gradient-range), transparent ($start-point + $gradient-range + $initial-offset + $text-width), #fff ($start-point + $gradient-range + $initial-offset + $offset + $text-width), #fff 100%);
  }
  &:hover {
    box-shadow: 0 0 4px rgba(0, 0, 0, 0.5);
    .background { height: 100%; opacity: 1; }
    .titleWrapper {
      translate: 30px 0;
      .titleText { color: #000; }
      svg { opacity: 1; }
    }
    .piercingLine { height: 100%; }
  }
}
