/*! XCSS fixture license */
@vars {
  --space = 8px;
  --accent: color;
  local --rotation: angle;
  --custom;
}
@injection outlined($width: length = 1px) {
  border: $width solid currentColor;
  @content;
}
.base { color: --accent; }
.button {
  composes: base;
  padding: --space * 2;
  transition: (display, opacity) .3s ease;
  @:outlined(2px) { border-radius: 4px; }
  &:hover { color: blue; }
}
.button::before { width: 1px; }
:global(.external) { color: red; }
@keyframes spin { from { opacity: 0; } to { opacity: 1; } }
.animated { animation: spin 1s; }
