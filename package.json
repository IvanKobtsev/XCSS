{
  "name": "cross-css-workspace",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "build": "pnpm --filter @cross-css/native build && pnpm --filter @cross-css/vite-plugin build",
    "check": "pnpm --filter @cross-css/vite-plugin typecheck",
    "test": "pnpm build && pnpm --filter @cross-css/native test && pnpm --filter @cross-css/vite-plugin test && pnpm --filter xcss-vite-fixture test",
    "verify-release": "node npm/verify-release.mjs",
    "pack:release": "node npm/pack-release.mjs",
    "test:release-packages": "node npm/test-release-packages.mjs"
  }
}
