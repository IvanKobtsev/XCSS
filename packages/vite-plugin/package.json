{
  "name": "@cross-css/vite",
  "version": "0.10.0",
  "description": "Compile Cross-CSS before Vite's CSS pipeline",
  "license": "MIT",
  "author": "Ivan Kobtsev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IvanKobtsev/XCSS.git",
    "directory": "packages/vite-plugin"
  },
  "homepage": "https://github.com/IvanKobtsev/XCSS#readme",
  "bugs": {
    "url": "https://github.com/IvanKobtsev/XCSS/issues"
  },
  "keywords": [
    "css",
    "css-modules",
    "vite",
    "rolldown",
    "rust"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "xcss": "./bin/xcss.cjs"
  },
  "exports": {
    "./client": {
      "types": "./client.d.ts"
    },
    "./units": {
      "types": "./dist/units.d.ts",
      "import": "./dist/units.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./react/jsx-runtime": {
      "types": "./dist/react/jsx-runtime.d.ts",
      "import": "./dist/react/jsx-runtime.js"
    },
    "./react/jsx-dev-runtime": {
      "types": "./dist/react/jsx-dev-runtime.d.ts",
      "import": "./dist/react/jsx-dev-runtime.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "client.d.ts",
    "dist",
    "README.md",
    "CLSX-LICENSE",
    "LICENSE"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "node ../../npm/verify-release.mjs"
  },
  "dependencies": {
    "@cross-css/native": "0.10.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.18.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.0.0",
    "vitest": "^4.0.6"
  }
}
